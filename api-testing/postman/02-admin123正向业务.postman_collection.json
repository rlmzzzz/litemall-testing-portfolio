    {
      "name": "2.4b [缺陷 Bug-5] 商品专柜价为负数未被拦截",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 2.4b [缺陷 Bug-5] 商品专柜价为负数未被拦截｜Bug-5：id=1181009 商品 counterPrice=-1.00，新增时后端未校验专柜价非负",
              "pm.test('HTTP 状态码为 200', function () { pm.response.to.have.status(200); });",
              "pm.test('响应为合法 JSON', function () { pm.response.to.be.json; });",
              "var j = pm.response.json();",
              "pm.test('响应含 errno 字段', function () { pm.expect(j).to.have.property('errno'); });",
              "pm.test('[缺陷验证] 专柜价 counterPrice 不应为负数', function () {",
              "    var cp = j.data.goods.counterPrice;",
              "    pm.expect(cp, '实际专柜价=' + cp + '，后端未校验非负，Bug-5 复现').to.be.at.least(0);",
              "});"
            ]
          }
        }
      ],
