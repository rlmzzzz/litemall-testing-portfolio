{
  "info": {
    "_postman_id": "02-admin123 超级管理员正向业务",
    "name": "02-admin123 超级管理员正向业务",
    "description": "先登录 admin123，再用其 token 访问全部后台接口。预期全部 errno=0。含 2 个缺陷验证项（会 FAIL，属预期内的已提缺陷）。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "2.1 登录 admin123（超级管理员）",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 登录 admin123，保存 token 到集合变量",
              "pm.test('HTTP 状态码为 200', function () { pm.response.to.have.status(200); });",
              "var j = pm.response.json();",
              "pm.test('登录成功 errno=0', function () { pm.expect(j.errno).to.eql(0); });",
              "pm.test('返回 token 不为空', function () { pm.expect(j.data.token).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('token', j.data.token);",
              "console.log('token = ' + j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin123\", \"password\": \"admin123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2.2 商品列表-分页查询",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 2.2 商品列表-分页查询｜有权限",
              "pm.test('HTTP 状态码为 200', function () { pm.response.to.have.status(200); });",
              "pm.test('响应为合法 JSON', function () { pm.response.to.be.json; });",
              "var j = pm.response.json();",
              "pm.test('响应含 errno 字段', function () { pm.expect(j).to.have.property('errno'); });",
              "pm.test('errno 应为 0（有权限）', function () {",
              "    pm.expect(j.errno, '实际 errno=' + j.errno + ' errmsg=' + j.errmsg).to.eql(0);",
              "});",
              "pm.test('返回 list 数组且不为空', function () { pm.expect(j.data.list).to.be.an('array'); pm.expect(j.data.list.length).to.be.above(0); });",
              "pm.test('分页生效：条数不超过 limit=5', function () { pm.expect(j.data.list.length).to.be.at.most(5); });",
              "pm.test('total 字段存在', function () { pm.expect(j.data).to.have.property('total'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Litemall-Admin-Token",
            "value": "{{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/goods/list?page=1&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "goods",
            "list"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      }
    },
