          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 4.9 [缺陷 Bug-7] 统计面板-越权成功｜Bug-7：AdminDashbordController 未加 @RequiresPermissions，低权限角色可越权访问",
              "pm.test('HTTP 状态码为 200', function () { pm.response.to.have.status(200); });",
              "pm.test('响应为合法 JSON', function () { pm.response.to.be.json; });",
              "var j = pm.response.json();",
              "pm.test('响应含 errno 字段', function () { pm.expect(j).to.have.property('errno'); });",
              "pm.test('errno 应为 506（Bug-7：AdminDashbordController 未加 @RequiresPermissions，低权限角色可越权访问）', function () {",
